{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiln.dev/schema/plugin-manifest.schema.json",
  "title": "Kiln plugin manifest",
  "description": "A plugin request. It does not grant any capability by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "protocol", "entrypoint", "capabilities"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "publisher": { "type": "string" },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": { "type": "integer", "minimum": 1 },
        "minor": { "type": "integer", "minimum": 0 }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "command"],
      "properties": {
        "transport": { "type": "string", "enum": ["stdio"] },
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "working_directory": { "type": "string" },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "workspace.read",
          "workspace.write",
          "process.spawn",
          "terminal.attach",
          "git.read",
          "git.write",
          "network.request",
          "browser.control",
          "model.request",
          "artifact.read",
          "artifact.write"
        ]
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "input_schema"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "input_schema": { "type": "object" }
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup_command": { "type": "string" },
        "shutdown_method": { "type": "string", "enum": ["json_rpc", "process_signal"] }
      }
    }
  }
}
